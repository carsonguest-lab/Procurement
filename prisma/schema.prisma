generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETE
}

enum MaterialStatus {
  NOT_ORDERED
  ORDERED
  DELIVERED
}

enum SubmittalStatus {
  NOT_SUBMITTED
  SUBMITTED
  APPROVED
  APPROVED_AS_NOTED
  REVISE_AND_RESUBMIT
  REJECTED
}

enum ScheduleImportStatus {
  PROCESSING
  READY_FOR_REVIEW
  FAILED
}

enum ExtractedTagStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectRole {
  MEMBER
  VIEWER
}

model User {
  id                      String               @id @default(cuid())
  name                    String
  email                   String               @unique
  passwordHash            String
  role                    Role                 @default(MEMBER)
  createdAt               DateTime             @default(now())
  loggedMaterial          MaterialItem[]       @relation("MaterialItemLoggedBy")
  scheduleImportsUploaded ScheduleImport[]     @relation("ScheduleImportUploadedBy")
  projectMemberships      ProjectMembership[]
  invitesSent             Invite[]             @relation("InviteInvitedBy")
  passwordResetTokens     PasswordResetToken[]
}

model Project {
  id              String              @id @default(cuid())
  name            String
  address         String?
  status          ProjectStatus       @default(ACTIVE)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime            @default(now())
  materialItems   MaterialItem[]
  scheduleImports ScheduleImport[]
  memberships     ProjectMembership[]
}

model ProjectMembership {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  role      ProjectRole
  createdAt DateTime    @default(now())

  @@unique([userId, projectId])
  @@index([projectId])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  tokenHash   String    @unique
  invitedBy   User?     @relation("InviteInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Vendor {
  id            String         @id @default(cuid())
  name          String
  trade         String?
  contactName   String?
  email         String?
  phone         String?
  notes         String?
  createdAt     DateTime       @default(now())
  materialItems MaterialItem[]
}

model MaterialItem {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  vendor    Vendor? @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  vendorId  String?

  material     String
  leadTimeDays Int?

  requiredOnSiteDate DateTime?
  orderByDate        DateTime?

  actualOrderDate    DateTime?
  actualDeliveryDate DateTime?

  status          MaterialStatus  @default(NOT_ORDERED)
  submittalStatus SubmittalStatus @default(NOT_SUBMITTED)
  notes           String?

  csiDivisionCode String?
  category        String?
  subcategory     String?

  loggedBy   User?   @relation("MaterialItemLoggedBy", fields: [loggedById], references: [id], onDelete: SetNull)
  loggedById String?

  extractedTag ExtractedTag?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([vendorId])
  @@index([status])
  @@index([csiDivisionCode])
}

model ScheduleImport {
  id           String               @id @default(cuid())
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId    String
  fileName     String
  fileUrl      String
  status       ScheduleImportStatus @default(PROCESSING)
  error        String?
  uploadedBy   User?                @relation("ScheduleImportUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
  createdAt    DateTime             @default(now())
  tags         ExtractedTag[]

  @@index([projectId])
}

model ExtractedTag {
  id             String             @id @default(cuid())
  import         ScheduleImport     @relation(fields: [importId], references: [id], onDelete: Cascade)
  importId       String
  tag            String
  description    String?
  pageNumber     Int?
  status         ExtractedTagStatus @default(PENDING)
  materialItem   MaterialItem?      @relation(fields: [materialItemId], references: [id], onDelete: SetNull)
  materialItemId String?            @unique
  createdAt      DateTime           @default(now())

  @@index([importId])
  @@index([status])
}
